# FRAME 중계 서버 앞단 Caddy 2 예시: HTTPS/WSS 종단, 인증서 자동 발급·갱신, relay.mjs로 역방향 프록시.
# /etc/caddy/Caddyfile 로 복사하고 relay.example.com 을 실제 도메인으로 바꾼다(DNS A/AAAA 레코드가 이 서버를 가리켜야 함).
# 브라우저는 이 주소만 사용한다. MediaMTX의 API·playback·HLS·WHEP 포트는 루프백이라 여기서 직접 노출하지 않는다.

{
	# email ops@example.com
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

relay.example.com {
	# 썸네일(256 KB) 업로드보다 약간 크게. WHEP SDP·등록 JSON은 훨씬 작다.
	request_body {
		max_size 300KB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# 화면·JSON·HLS 재생목록(텍스트)만 압축한다. DVR 조각(video/mp4)·HLS 미디어(m4s/mp4)·썸네일(jpeg)·글꼴(woff2)은
	# 이미 압축되어 있어 CPU만 쓰므로 제외한다. "encode @이름"은 요청 조건이라(GET에는 Content-Type이 없음) 아무것도
	# 압축하지 않는다. 그래서 응답 헤더를 보는 match 블록을 쓴다(같은 헤더의 여러 값은 OR).
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/vnd.apple.mpegurl*
		}
	}

	reverse_proxy 127.0.0.1:8080 {
		# DVR 조각(chunked)과 LL-HLS 블로킹 요청을 버퍼링 없이 바로 흘려보낸다.
		flush_interval -1
		# Caddy는 X-Forwarded-For/-Proto/-Host를 직접 채운다(클라이언트가 보낸 값은 버림).
		# relay.env의 RELAY_TRUSTED_PROXIES=127.0.0.1 과 짝을 이룬다. WebSocket(/<path>/chat)은 자동으로 중계된다.
		transport http {
			dial_timeout 5s
			# relay.mjs keepAliveTimeout(65 s)보다 짧게: 서버가 막 닫은 연결을 재사용해 502가 나는 일을 막는다.
			keepalive 60s
			# relay.mjs의 업스트림 제한(DVR 조각 20 s, WHEP 20 s, LL-HLS 블로킹 15 s)보다 넉넉히 길게: 항상 relay가 먼저
			# 503/502로 답하고 Caddy가 그 전에 연결을 끊지 않는다.
			response_header_timeout 45s
		}
	}

	log {
		output file /var/log/caddy/frame-relay.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}
