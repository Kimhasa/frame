# FRAME 중계 웹 서비스(server/relay.mjs) 설정 예시. 실제 값은 /etc/frame-relay/relay.env (권한 600)에 둔다.
# 이 파일에는 실제 비밀 값을 넣지 않는다(저장소에 올라가는 예시). *.env는 .gitignore 대상이다.

# --- 주소 -------------------------------------------------------------------------------------------------------
# relay.mjs는 루프백에서만 듣고, 인터넷 쪽 HTTPS/WSS는 Caddy가 받는다.
RELAY_LISTEN_HOST=127.0.0.1
RELAY_PORT=8080
# 시청자가 여는 공개 주소. 목록의 baseUrl·썸네일 주소가 이 값으로 고정된다(Host 헤더 위조 방지).
RELAY_PUBLIC_BASE_URL=https://relay.example.com
# X-Forwarded-For/-Proto/-Host를 믿을 프록시(Caddy) 주소.
RELAY_TRUSTED_PROXIES=127.0.0.1,::1

# --- 화면 파일 --------------------------------------------------------------------------------------------------
# 송출 앱과 같은 빌드 결과(outputs/index.html, dist/FrameConsole/ui/index.html)를 그대로 쓴다.
RELAY_UI_FILE=/opt/frame-relay/ui/index.html
# RELAY_FONTS_DIR=/opt/frame-relay/ui/assets/fonts

# --- 송출 인증(비밀) ----------------------------------------------------------------------------------------------
# 방송 등록·썸네일 업로드용 Bearer 토큰. 24자 이상, 송출 PC마다 다르게, 그 PC가 쓸 경로와 함께 적는다:
#   <토큰> <경로> [<경로> ...]      예: 3f9c...e1 screen-01
# 토큰은 자기 경로만 등록·종료·썸네일할 수 있다(mediamtx-relay.yml의 송출 계정 경로와 같게). "*"는 모든 경로(시험용만).
# 파일 방식을 권장한다(한 줄에 하나, # 주석). 생성 예: openssl rand -hex 32
RELAY_PUBLISHER_TOKENS_FILE=/etc/frame-relay/publisher-tokens
# RELAY_PUBLISHER_TOKENS=<토큰> screen-01,<토큰> screen-02

# --- 중계 MediaMTX (모두 루프백) ---------------------------------------------------------------------------------
RELAY_MEDIAMTX_API=http://127.0.0.1:9997
RELAY_MEDIAMTX_WEBRTC=http://127.0.0.1:8889
RELAY_MEDIAMTX_HLS=http://127.0.0.1:8888
RELAY_MEDIAMTX_PLAYBACK=http://127.0.0.1:9996
# mediamtx-relay.yml의 recordPath 기준 폴더(MediaMTX 작업 폴더/recordings). DVR 키프레임 기준점에 쓴다.
RELAY_RECORD_DIR=/var/lib/frame-relay/recordings

# --- 기능 -------------------------------------------------------------------------------------------------------
RELAY_DVR=1
RELAY_HLS=1
# iPhone 기본 HLS용 AAC 변환 경로(/<path>/aac/hls/...). 서버 FFmpeg 필요. 실기기 검증 전에는 0 권장.
RELAY_HLS_AAC=0
# 서버에서 만드는 하위 화질(mediamtx-relay.yml의 720p/480p/360p 정의와 맞춘다). 비워 두면 원본만 광고한다.
# 화질 하나당 시청자가 있는 동안 FFmpeg 1개(720p30 기준 대략 CPU 1코어). 무료 VM에서는 비워 두고 시작한다.
RELAY_RENDITIONS=

# --- 재생 통계(POST /<path>/stats) ------------------------------------------------------------------------------
# 시청 페이지가 보내는 재생 보고를 하루 하나의 CSV(stats-YYYY-MM-DD.csv, UTC)로 쌓는다. IP·브라우저 정보는 저장하지 않는다.
# 비우면 받기만 하고 저장하지 않는다. 하루 파일 상한(MB)을 넘으면 그날 나머지는 버린다. 보존 일수가 지난 파일은 지운다.
RELAY_STATS_DIR=/var/lib/frame-relay/stats
RELAY_STATS_MAX_MB=50
RELAY_STATS_KEEP_DAYS=30

# --- ICE(STUN/TURN) ---------------------------------------------------------------------------------------------
# 서버가 공인 IP를 가지면 대부분 STUN/TURN 없이 연결된다. UDP·8189가 막힌 회사망 대비로 TURN(TLS 443)을 둔다.
# 정적 서버 목록(JSON). 비밀번호가 고정된 TURN은 넣지 말고 아래 REST 방식(짧은 수명)을 쓴다.
RELAY_ICE_SERVERS=[]
# coturn use-auth-secret 방식: /info 요청마다 수명 RELAY_TURN_TTL_S초의 사용자/자격 증명을 만든다.
RELAY_TURN_URLS=
RELAY_TURN_SECRET=
RELAY_TURN_TTL_S=3600

# --- 상한(초과 시 503 + Retry-After) -------------------------------------------------------------------------------
RELAY_MAX_SOCKETS=4000
RELAY_MAX_CHAT=2000
RELAY_MAX_CHAT_PER_IP=50
RELAY_MAX_VIEWERS_PER_PATH=1000
RELAY_MAX_WHEP_INFLIGHT=64
RELAY_MAX_DVR_STREAMS=200
RELAY_MAX_HLS_INFLIGHT=3000
RELAY_MAX_BROADCASTS=64
# 한 주소가 동시에 받을 수 있는 DVR 조각 / HLS 요청 수(한 클라이언트가 전체 상한을 차지하지 못하게).
RELAY_MAX_DVR_PER_IP=16
RELAY_MAX_HLS_PER_IP=300
# HLS 시청자는 이 시간 안에 요청이 있었으면 시청자 상한(RELAY_MAX_VIEWERS_PER_PATH)에 함께 센다.
RELAY_HLS_ACTIVE_MS=12000
# IP별 토큰 버킷 "순간허용/초당보충". 이동통신 CGNAT는 많은 휴대폰이 한 주소를 공유하므로 너무 낮추지 않는다.
# 송출 요청(등록·썸네일) 주소별 상한. 토큰 비교 전에 적용되어, 제한 중에는 올바른 토큰도 429(추측 무력화).
RELAY_RATE_PUBLISH_IP=60/10
RELAY_RATE_ANNOUNCE=30/5
RELAY_RATE_AUTH_FAIL=10/0.1667
RELAY_RATE_CHAT_CONNECT=60/5
RELAY_RATE_CHAT_SEND=60/6
RELAY_RATE_WHEP=60/2
RELAY_RATE_DVR=120/20
RELAY_RATE_STATS=120/20

# 마지막 등록 후 이 시간이 지나면 목록에서 빠진다(송출 앱은 2초마다 등록).
RELAY_ANNOUNCE_TTL_MS=15000
# 등록은 살아 있는데 영상만 끊긴 경우(송출 PC 재연결, 중계 MediaMTX 재시작) /info가 {"running":true,"mediaReady":false}를
# 유지하는 시간. 시청자는 이 동안 "송출 종료" 대신 기다린다. 만료 뒤 같은 토큰에게 경로를 이 시간만큼 더 예약한다.
RELAY_MEDIA_GRACE_MS=15000
# MediaMTX API가 느리거나 실패할 때 마지막 정상 경로 목록을 유지하는 시간(/healthz의 mediamtxListStale).
RELAY_MEDIAMTX_STALE_MS=15000
RELAY_LOG_LEVEL=info
