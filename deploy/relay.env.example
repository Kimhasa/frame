# FRAME 중계 웹 서비스(apps/api의 frame-api.jar, Spring Boot) 설정 예시. 실제 값은 /etc/frame-relay/relay.env (권한 640, root:frame-relay)에 둔다.
# 이 파일에는 실제 비밀 값을 넣지 않는다(저장소에 올라가는 예시). *.env는 .gitignore 대상이다.
# systemd가 EnvironmentFile로 읽는다: 한 줄에 "이름=값", 따옴표·줄 끝 주석 없이 쓴다. 빈 값은 설정하지 않은 것과 같다.
# 범위를 벗어난 값과 형식이 틀린 RELAY_RATE_*는 서비스가 시작하지 않고 그 변수 이름을 로그에 남긴다. 숫자·스위치(1/0, true/false,
# on/off) 형식이 틀린 값도 시작하지 않으며, 그때 로그에는 설정 이름(frame.…)과 그 값이 나온다.
# 어떤 설정도 읽지 않는 RELAY_* 이름(오타)은 시작 로그에 경고로 나온다. 값에 "${"는 쓰지 않는다(자리표시로 해석된다).

# --- 실행(JVM) --------------------------------------------------------------------------------------------------
# java 실행 파일이 읽는 JVM 옵션. 힙 상한을 고정하고(기본값은 서버 RAM의 1/4), 메모리가 모자라면 끝내서 systemd가 다시 띄우게 한다.
# RAM 2 GB 서버 기준 512m, 1 GB면 256m. 로컬 측정(힙 256 MB, 중계 e2e와 채팅 1,000 연결)은 deploy/README.md 3장.
JDK_JAVA_OPTIONS=-Xmx512m -XX:+ExitOnOutOfMemoryError

# --- 주소 -------------------------------------------------------------------------------------------------------
# 중계 웹 서비스는 루프백에서만 듣고, 인터넷 쪽 HTTPS/WSS는 Caddy가 받는다.
RELAY_LISTEN_HOST=127.0.0.1
RELAY_PORT=8080
# 시청자가 여는 공개 주소. 목록의 baseUrl·썸네일 주소가 이 값으로 고정된다(Host 헤더 위조 방지).
RELAY_PUBLIC_BASE_URL=https://relay.example.com
# X-Forwarded-For/-Proto/-Host를 믿을 프록시(Caddy) 주소.
RELAY_TRUSTED_PROXIES=127.0.0.1,::1

# --- 화면 파일 --------------------------------------------------------------------------------------------------
# 기존 단일 파일 시청 화면(/, /<path>). 송출 앱과 같은 빌드 결과(outputs/index.html, dist/FrameConsole/ui/index.html)를 그대로 쓴다.
# 여기 적은 파일만 읽는다. 비우면 그 주소는 404다. 글꼴·스크립트 폴더의 기본값은 이 파일 옆의 assets/fonts, assets/js.
RELAY_UI_FILE=/opt/frame-relay/ui/index.html
# RELAY_FONTS_DIR=/opt/frame-relay/ui/assets/fonts
# RELAY_JS_DIR=/opt/frame-relay/ui/assets/js

# --- 송출 인증(비밀) ----------------------------------------------------------------------------------------------
# 방송 등록·썸네일 업로드용 Bearer 토큰. 24자 이상, 송출 PC마다 다르게, 그 PC가 쓸 경로와 함께 적는다:
#   <토큰> <경로> [<경로> ...]      예: 3f9c...e1 screen-01
# 토큰은 자기 경로만 등록·종료·썸네일할 수 있다(mediamtx-relay.yml의 송출 계정 경로와 같게). "*"는 모든 경로(시험용만).
# 파일 방식을 권장한다(한 줄에 하나, # 주석). 생성 예: openssl rand -hex 32
RELAY_PUBLISHER_TOKENS_FILE=/etc/frame-relay/publisher-tokens
# RELAY_PUBLISHER_TOKENS=<토큰> screen-01,<토큰> screen-02

# --- OBS 입력(선택, deploy/OBS.md) ---------------------------------------------------------------------------------
# obs-* 경로에 MediaMTX RTMP 입력이 도착하면 Spring이 자동 등록한다. 기존 native 송출은 그대로 동작한다.
# 방송자별 고유 토큰/경로와 MediaMTX 사용자/비밀번호 해시를 먼저 준비한다. 기본은 꺼짐.
# RELAY_OBS_ENABLED=true
# RELAY_OBS_SERVER_URL=rtmps://ingest.example.com:1936
# 같은 PC에서만 시험: RELAY_OBS_SERVER_URL=rtmp://127.0.0.1:1935

# --- 중계 MediaMTX (모두 루프백) ---------------------------------------------------------------------------------
RELAY_MEDIAMTX_API=http://127.0.0.1:9997
RELAY_MEDIAMTX_WEBRTC=http://127.0.0.1:8889
RELAY_MEDIAMTX_HLS=http://127.0.0.1:8888
RELAY_MEDIAMTX_PLAYBACK=http://127.0.0.1:9996
# mediamtx-relay.yml의 recordPath 기준 폴더(MediaMTX 작업 폴더/recordings). 녹화는 <폴더>/<path>/rec/*.mp4(복사 경로 <path>/rec).
# DVR 키프레임 기준점과 HLS 다시보기(dvr.m3u8, dvr/file)가 이 파일을 읽는다. 비우면 dvr.m3u8을 광고하지 않는다.
RELAY_RECORD_DIR=/var/lib/frame-relay/recordings

# --- 기능 -------------------------------------------------------------------------------------------------------
RELAY_DVR=1
RELAY_HLS=1
# AAC 트랙 없이 올리는 송출(이전 버전 앱)의 HLS 음성 대체: 서버에서 Opus→AAC 변환 경로(/<path>/aac/hls/...)를 쓴다(원본 화질만).
# 서버 FFmpeg 필요. 지금 앱은 AAC를 둘째 음성으로 함께 올리므로 0이어도 HLS 음성이 있다(0이면 이전 앱의 HLS는 영상만).
RELAY_HLS_AAC=0
# 서버에서 만드는 하위 화질(예: 720p,480p,360p 또는 480p:1.8). 비워 두면 원본만 광고한다.
# 방송마다 FFmpeg 하나(화질 래더, apps/api의 quality/Ladders)가 원본 복사본(<path>/src)과 이 화질들을 같은 시계로 만든다.
# 방송 미디어가 들어오면 바로 뜨고, 모든 화질에 시청자가 RELAY_LADDER_IDLE_MS 동안 없으면 멈춘다(다음 요청 때 다시 뜸).
# 화질 하나당 대략 CPU 1코어(720p30 libx264 기준, 추정). 무료 VM에서는 비워 두고 시작한다.
RELAY_RENDITIONS=
# 래더가 실행할 FFmpeg(이름만 쓰면 /usr/local/bin, /usr/bin 등 systemd 기본 PATH에서 찾는다. 다른 곳이면 절대 경로),
# 원본을 읽고 화질을 올리는 루프백 RTSP(mediamtx-relay.yml의 rtspAddress), 유휴 종료 시간(ms).
RELAY_FFMPEG=ffmpeg
RELAY_MEDIAMTX_RTSP=rtsp://127.0.0.1:8554
RELAY_LADDER_IDLE_MS=300000

# --- 재생 통계(POST /<path>/stats) ------------------------------------------------------------------------------
# 시청 페이지가 보내는 재생 보고를 하루 하나의 CSV(stats-YYYY-MM-DD.csv, UTC)로 쌓는다. IP·브라우저 정보는 저장하지 않는다.
# 비우면 받기만 하고 저장하지 않는다. 하루 파일 상한(MB)을 넘으면 그날 나머지는 버린다. 보존 일수가 지난 파일은 지운다.
RELAY_STATS_DIR=/var/lib/frame-relay/stats
RELAY_STATS_MAX_MB=50
RELAY_STATS_KEEP_DAYS=30

# --- ICE(STUN/TURN) ---------------------------------------------------------------------------------------------
# 서버가 공인 IP를 가지면 대부분 STUN/TURN 없이 연결된다. UDP·8189가 막힌 회사망 대비로 TURN(TLS 443)을 둔다.
# 정적 서버 목록(JSON). 비밀번호가 고정된 TURN은 넣지 말고 아래 REST 방식(짧은 수명)을 쓴다.
RELAY_ICE_SERVERS=[]
# coturn use-auth-secret 방식: /info 요청마다 수명 RELAY_TURN_TTL_S초의 사용자/자격 증명을 만든다.
RELAY_TURN_URLS=
RELAY_TURN_SECRET=
RELAY_TURN_TTL_S=3600

# --- 상한(초과 시 503 + Retry-After) -------------------------------------------------------------------------------
RELAY_MAX_SOCKETS=4000
RELAY_MAX_CHAT=2000
RELAY_MAX_CHAT_PER_IP=50
RELAY_MAX_VIEWERS_PER_PATH=1000
RELAY_MAX_WHEP_INFLIGHT=64
RELAY_MAX_DVR_STREAMS=200
RELAY_MAX_HLS_INFLIGHT=3000
RELAY_MAX_BROADCASTS=64
# 한 주소가 동시에 받을 수 있는 DVR 조각 / HLS 요청 수(한 클라이언트가 전체 상한을 차지하지 못하게).
RELAY_MAX_DVR_PER_IP=16
RELAY_MAX_HLS_PER_IP=300
# 시청자 수 = WebRTC 세션 + 활성 시청 세션(POST /<path>/session, 15초마다 PUT, 마지막 하트비트가 이 시간 안이면 활성).
# 상한(RELAY_MAX_VIEWERS_PER_PATH)은 새 세션·새 WHEP에만 적용된다(503 + Retry-After). HLS 미디어 요청은 상한으로 거절하지 않는다.
RELAY_SESSION_ACTIVE_MS=30000
# 한 주소가 동시에 가질 수 있는 시청 세션 수(CGNAT 뒤 여러 휴대폰을 고려해 넉넉히).
RELAY_MAX_SESSIONS_PER_IP=200
# 세션 없이 HLS만 받는 클라이언트도 주소+브라우저별로 최근 RELAY_HLS_ACTIVE_MS 안에 요청했으면 함께 센다(대체 집계).
# CDN 뒤에서는 중계 웹 서비스가 CDN의 캐시 미스만 보므로 0으로 둔다(세션만 센다).
RELAY_HLS_COUNT_WITHOUT_SESSION=1
RELAY_HLS_ACTIVE_MS=12000
# IP별 토큰 버킷 "순간허용/초당보충". 이동통신 CGNAT는 많은 휴대폰이 한 주소를 공유하므로 너무 낮추지 않는다.
# 송출 요청(등록·썸네일) 주소별 상한. 토큰 비교 전에 적용되어, 제한 중에는 올바른 토큰도 429(추측 무력화).
RELAY_RATE_PUBLISH_IP=60/10
RELAY_RATE_ANNOUNCE=30/5
RELAY_RATE_AUTH_FAIL=10/0.1667
RELAY_RATE_CHAT_CONNECT=60/5
RELAY_RATE_CHAT_SEND=60/6
RELAY_RATE_WHEP=60/2
RELAY_RATE_DVR=120/20
RELAY_RATE_STATS=120/20
RELAY_RATE_SESSION=60/2

# 마지막 등록 후 이 시간이 지나면 목록에서 빠진다(송출 앱은 2초마다 등록).
RELAY_ANNOUNCE_TTL_MS=15000
# 등록은 살아 있는데 영상만 끊긴 경우(송출 PC 재연결, 중계 MediaMTX 재시작) /info가 {"running":true,"mediaReady":false}를
# 유지하는 시간. 시청자는 이 동안 "송출 종료" 대신 기다린다. 만료 뒤 같은 토큰에게 경로를 이 시간만큼 더 예약한다.
RELAY_MEDIA_GRACE_MS=15000
# MediaMTX API가 느리거나 실패할 때 마지막 정상 경로 목록을 유지하는 시간(/healthz의 mediamtxListStale).
RELAY_MEDIAMTX_STALE_MS=15000
# 이 서비스 자체 로그의 수준: error, warn, info, debug, trace 중 하나(다른 값이면 시작하지 않는다). 토큰·비밀번호는 어느 수준에서도 쓰지 않는다.
RELAY_LOG_LEVEL=info
