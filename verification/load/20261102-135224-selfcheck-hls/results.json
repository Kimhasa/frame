  "definitions": {
    "viewer": "one Node LL-HLS client (lib/hls-client.mjs, 1 worker threads): live.m3u8 -> the variant of its quality -> init -> parts with blocking playlist reloads (_HLS_msn/_HLS_part) + the AAC rendition, viewer session with heartbeat; no decoding or rendering",
    "hls": {
      "firstMedia": "the first part/segment of every followed track (video and AAC) received completely after init; readyTime = that moment on the receiver clock",
      "delay": "estimated delay = now - position of a virtual player that starts at the first unit it received (1.5 s behind the newest media, like the page liveSyncDuration), plays in real time while media is buffered, catches up at 1.1x when more than liveSync + 0.5 s is buffered, and stops at the buffer end; positions come from EXT-X-PROGRAM-DATE-TIME (the target MediaMTX clock at ingest). Needs the generator and target clocks in sync; excludes capture, encode and publish before MediaMTX, and decode/render after. The real delay is the browser sampler one (barcode / hls.js playingDate).",
      "stall": "no new video part/segment for more than 3000 ms (counted when media resumes, plus one per viewer still stalled at the hold end)",
      "busy": "requests answered 429 or 503 (session, live.m3u8, playlists, init, parts, segments); waits follow Retry-After (1-30 s, jitter), at most 6 in a row before the viewer restarts",
      "traffic": "media bytes (init, parts, segments) of video and AAC; playlist bytes are counted separately (playlistBytesPerMediaByte)"
    },
    "receiving": "received bytes grew by more than 0 kbit/s in a 2000 ms sample window",
    "firstMedia": "join requested (ramp slot, burst start or churn re-join; queueing included) -> the viewer's generator path has media: ready, with tracks and received bytes. The time is the path ready time (tracks gathered = first RTP) when it is a real time not before the request; MediaMTX's zero-year placeholder and earlier times are ignored. Without a usable ready time the sample clock is used and counted in firstMediaMs.basis / firstMediaFromSampleClock (error up to one sample interval).",
    "reconnect": "media again after a loss, or a new real ready time of the same session; the placeholder -> real ready time transition is not a reconnect",
    "sustained": "first media and receiving in >= 95% of the hold windows; successRate = sustained / requested",
    "fullRate": "sustained, and every quality segment the viewer watched in the hold (>= 4 s) has a mean rate >= 90% of that quality's reference (reference.<quality>.from); fullRateSuccessRate = full-rate viewers / (requested or sessions seen) minus sessions too short to judge (fullRateTooShort, all segments < minSegmentSec), not measured when a watched quality has no reference (an idle path's ingest 0 is no reference)",
    "fullRateLive": "per sample: share of viewers whose rolling 10 s rate is >= 90% of their quality's rolling reference (stop rule degraded-below-min)",
    "stall": "a 2000 ms window without growth (<= 0 kbit/s); stallTimeRatio = stalled time / observed time after first media",
    "cpuPct": "percent of the whole machine (all logical CPUs) from process CPU time; cores = same in CPU cores",
    "unattributedCpuPct": "host CPU minus generator, target and browser-sampler processes: other programs and kernel network time; a stage is flagged externalLoad when its hold mean is above 25%",
    "rtpPacketsLost": "losses reported by the generator WebRTC sources (MediaMTX log, \"1 RTP packet lost\" and \"N RTP packets lost\"); lossRatioEst assumes ~1,150 B per RTP packet",
    "whep": "WHEP signalling seen by the loopback tap (status per offer, Retry-After values); MediaMTX's WHEP client itself retries about every 5 s whatever Retry-After says",
    "traffic": "bytes received by the generator's protocol viewers (browser pages not counted)",
    "network": "generator and target location are recorded in host/target; loopback or same-PC traffic does not cross the NIC"
  },
  "notMeasured": [
    "decoded FPS, rendering, A/V sync, player rebuffering and live latency are not measured by protocol viewers (see browser sampler fields)",
    "HLS: the delay estimate is not the player delay (no decode/render, MediaMTX ingest clock); RTP loss and ICE do not apply",
    "HLS: requests the target refused are seen only as the answers the receiver got"
  ],
