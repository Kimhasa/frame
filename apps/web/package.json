{
  "name": "frame-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:relay": "vite --host 127.0.0.1 --mode relay",
    "preview:relay": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "yarn typecheck && vite build",
    "build:design": "yarn typecheck && vite build --mode design --outDir dist-design"
  },
  "dependencies": {
    "hls.js": "1.5.20",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
