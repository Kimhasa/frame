{
  "name": "abr-outage",
  "description": "대역폭 여유(30 Mbps)에서 양방향 끊김 1·3·6·12초. 끊김 뒤 같은 연결로 돌아오는지, 끊김(재생 정지)을 이유로 화질을 내렸다면 회선이 정상인 동안 얼마 만에 원래 화질로 돌아오는지(상향 대기 12초 이상) 본다. 회복 구간은 45~60초.",
  "defaults": {
    "both": { "rateMbps": 30, "maxQueueMs": 250, "delayMs": 20 }
  },
  "steps": [
    { "label": "normal", "duration": 40 },
    { "label": "cut-1s", "duration": 1, "outage": true },
    { "label": "after-1s", "duration": 45 },
    { "label": "cut-3s", "duration": 3, "outage": true },
    { "label": "after-3s", "duration": 45 },
    { "label": "cut-6s", "duration": 6, "outage": true },
    { "label": "after-6s", "duration": 60 },
    { "label": "cut-12s", "duration": 12, "outage": true },
    { "label": "after-12s", "duration": 60 }
  ]
}
