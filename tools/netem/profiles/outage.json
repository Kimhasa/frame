    { "label": "after-0.5s", "duration": 20 },
    { "label": "cut-2s", "duration": 2, "outage": true },
    { "label": "after-2s", "duration": 20 },
    { "label": "cut-5s", "duration": 5, "outage": true },
    { "label": "after-5s", "duration": 20 },
    { "label": "cut-10s", "duration": 10, "outage": true },
    { "label": "after-10s", "duration": 25 }
  ]
