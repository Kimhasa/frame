{
  "name": "loss-jitter",
  "description": "대역폭 여유(30 Mbps)에서 하향 손실과 지연 변동만 단계적으로 키운다. smooth 지터는 큐처럼 지연이 서서히 변하고(순서 유지), packet 지터는 netem처럼 패킷마다 독립적으로 흔들려 순서가 바뀔 수 있다. 손실·지터를 대역폭 부족으로 오판해 화질을 내리는지, 버스트 손실 뒤 회복하는지 시험한다.",
  "defaults": {
    "down": { "rateMbps": 30, "maxQueueMs": 250, "delayMs": 25 },
    "up": { "rateMbps": 5, "maxQueueMs": 250, "delayMs": 25 }
  },
  "steps": [
    { "label": "clean", "duration": 20 },
    { "label": "loss0.5-j5", "duration": 20, "down": { "lossPct": 0.5, "jitterMs": 5 } },
    { "label": "loss2-j15", "duration": 20, "down": { "lossPct": 2, "jitterMs": 15 } },
    { "label": "loss5-burst3-j30", "duration": 20, "down": { "lossPct": 5, "lossBurst": 3, "jitterMs": 30 } },
    { "label": "loss10-j10", "duration": 20, "down": { "lossPct": 10, "jitterMs": 10 } },
    { "label": "packet-jitter20", "duration": 20, "down": { "jitterMs": 20, "jitterMode": "packet" } },
    { "label": "clean-again", "duration": 20 }
  ]
}
